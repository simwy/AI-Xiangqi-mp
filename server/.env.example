# demo: isolated local persistence, no paid model calls. live: uniCloud only.
APP_MODE=demo
HOST=127.0.0.1
PORT=8787
# Set a random 32+ character value before using /admin.
ADMIN_TOKEN=
VISITOR_SECRET=
# URLized xiangqi-store cloud function and matching xiangqi-config secret.
UNICLOUD_STORE_URL=
UNICLOUD_GATEWAY_SECRET=
# Optional AES-GCM key encryption master; retain this when migrating servers.
MODEL_KEY_SECRET=
MOVE_INTERVAL_MS=6000
BETWEEN_GAMES_MS=10000
DEMO_THINK_MS=1200
INLINE_ARCHIVE_LIMIT=1400000
ALLOW_PRIVATE_MODELS=false
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Configure these independently of the chat model API key.
TTS_APP_ID=
TTS_ACCESS_TOKEN=
TTS_RESOURCE_ID=
TTS_VOICE_ID=
