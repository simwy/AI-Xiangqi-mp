{
  "bsonType": "object",
  "description": "一局一条：普通对局、残局、导入和续弈共用完整 JSON 档案。",
  "required": [
    "schema_version",
    "title",
    "type",
    "status",
    "version",
    "initial_position",
    "current_fen",
    "steps"
  ],
  "permission": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false,
    "count": false
  },
  "properties": {
    "_id": {
      "bsonType": "string",
      "description": "稳定文档 ID；由服务端生成或导入时重新分配"
    },
    "schema_version": {
      "bsonType": "int",
      "description": "导入导出文档格式版本",
      "enum": [
        1
      ],
      "defaultValue": 1
    },
    "title": {
      "bsonType": "string",
      "description": "棋局/残局名称",
      "minLength": 1,
      "maxLength": 200
    },
    "type": {
      "bsonType": "string",
      "description": "对局类型",
      "enum": [
        "standard",
        "endgame",
        "continuation"
      ],
      "defaultValue": "standard"
    },
    "status": {
      "bsonType": "string",
      "description": "棋局状态",
      "enum": [
        "draft",
        "queued",
        "playing",
        "paused",
        "finished",
        "imported"
      ],
      "defaultValue": "draft"
    },
    "version": {
      "bsonType": "int",
      "description": "乐观并发控制版本；每次写入原子递增",
      "minimum": 0,
      "defaultValue": 0
    },
    "players": {
      "bsonType": "object",
      "description": "红黑双方身份快照",
      "properties": {
        "red": {
          "bsonType": "object",
          "description": "棋手身份及无密钥配置快照",
          "properties": {
            "model_id": {
              "bsonType": "string",
              "description": "模型配置 ID"
            },
            "display_name": {
              "bsonType": "string",
              "description": "本局使用的显示名称"
            },
            "avatar_url": {
              "bsonType": "string",
              "description": "本局使用的形象图"
            },
            "model_name": {
              "bsonType": "string",
              "description": "本局实际模型名"
            },
            "model_revision": {
              "bsonType": "int",
              "description": "配置版本",
              "minimum": 0
            },
            "thinking_mode": {
              "bsonType": "string",
              "description": "开局时思考配置",
              "enum": [
                "default",
                "enabled",
                "disabled"
              ]
            },
            "reasoning_effort": {
              "bsonType": "string",
              "description": "开局时思考强度"
            }
          },
          "required": [
            "model_id",
            "display_name"
          ]
        },
        "black": {
          "bsonType": "object",
          "description": "棋手身份及无密钥配置快照",
          "properties": {
            "model_id": {
              "bsonType": "string",
              "description": "模型配置 ID"
            },
            "display_name": {
              "bsonType": "string",
              "description": "本局使用的显示名称"
            },
            "avatar_url": {
              "bsonType": "string",
              "description": "本局使用的形象图"
            },
            "model_name": {
              "bsonType": "string",
              "description": "本局实际模型名"
            },
            "model_revision": {
              "bsonType": "int",
              "description": "配置版本",
              "minimum": 0
            },
            "thinking_mode": {
              "bsonType": "string",
              "description": "开局时思考配置",
              "enum": [
                "default",
                "enabled",
                "disabled"
              ]
            },
            "reasoning_effort": {
              "bsonType": "string",
              "description": "开局时思考强度"
            }
          },
          "required": [
            "model_id",
            "display_name"
          ]
        }
      },
      "required": [
        "red",
        "black"
      ]
    },
    "initial_position": {
      "bsonType": "object",
      "description": "所有回放和规则判断的起点",
      "properties": {
        "fen": {
          "bsonType": "string",
          "description": "初始完整 FEN；导入时逐项校验"
        },
        "side_to_move": {
          "bsonType": "string",
          "description": "初始先走方，必须与 FEN 一致",
          "enum": [
            "red",
            "black"
          ]
        }
      },
      "required": [
        "fen",
        "side_to_move"
      ]
    },
    "current_fen": {
      "bsonType": "string",
      "description": "当前局面，与初始局面及已提交 steps 必须一致"
    },
    "ply_count": {
      "bsonType": "int",
      "description": "已提交的半回合数",
      "minimum": 0,
      "defaultValue": 0
    },
    "last_event_seq": {
      "bsonType": "int",
      "description": "已提交的最后事件序号",
      "minimum": 0,
      "defaultValue": 0
    },
    "steps": {
      "bsonType": "array",
      "description": "完整逐步档案；一局不拆成多条步骤记录",
      "items": {
        "bsonType": "object",
        "description": "一次已提交的合法落子及完整附属档案",
        "properties": {
          "seq": {
            "bsonType": "int",
            "description": "从 1 开始的半回合序号",
            "minimum": 1
          },
          "side": {
            "bsonType": "string",
            "description": "走方",
            "enum": [
              "red",
              "black"
            ]
          },
          "move": {
            "bsonType": "object",
            "description": "起终点与棋子",
            "properties": {
              "piece_id": {
                "bsonType": "string",
                "description": "棋子稳定 ID"
              },
              "from": {
                "bsonType": "array",
                "description": "棋盘坐标 [x,y]，x 为 0..8，y 为 0..9；服务端进一步校验",
                "items": {
                  "bsonType": "int",
                  "description": "坐标整数",
                  "minimum": 0,
                  "maximum": 9
                },
                "minItems": 2,
                "maxItems": 2
              },
              "to": {
                "bsonType": "array",
                "description": "棋盘坐标 [x,y]，x 为 0..8，y 为 0..9；服务端进一步校验",
                "items": {
                  "bsonType": "int",
                  "description": "坐标整数",
                  "minimum": 0,
                  "maximum": 9
                },
                "minItems": 2,
                "maxItems": 2
              },
              "captured_piece_id": {
                "bsonType": "string",
                "description": "被吃棋子 ID；未吃子省略"
              }
            },
            "required": [
              "from",
              "to"
            ]
          },
          "notation": {
            "bsonType": "string",
            "description": "规范中文着法"
          },
          "fen_before": {
            "bsonType": "string",
            "description": "落子前完整 FEN"
          },
          "fen_after": {
            "bsonType": "string",
            "description": "落子后完整 FEN"
          },
          "committed_at": {
            "bsonType": "timestamp",
            "description": "服务端确认落子 UTC 毫秒"
          },
          "decision_ms": {
            "bsonType": "int",
            "description": "含重试的总决策耗时，不含解说及语音生成",
            "minimum": 0
          },
          "validation_ms": {
            "bsonType": "int",
            "description": "规则校验耗时",
            "minimum": 0
          },
          "calls": {
            "bsonType": "array",
            "description": "本步所有模型调用与重试记录",
            "items": {
              "bsonType": "object",
              "description": "一次模型请求；失败、重试及中断均保留；禁止包含 Key 和私有推理全文",
              "properties": {
                "id": {
                  "bsonType": "string",
                  "description": "调用唯一标识"
                },
                "purpose": {
                  "bsonType": "string",
                  "description": "请求用途",
                  "enum": [
                    "move",
                    "commentary",
                    "summary"
                  ]
                },
                "attempt": {
                  "bsonType": "int",
                  "description": "从 1 开始的尝试号",
                  "minimum": 1
                },
                "model_id": {
                  "bsonType": "string",
                  "description": "模型表 ID"
                },
                "model_revision": {
                  "bsonType": "int",
                  "description": "开始请求时的模型配置版本",
                  "minimum": 0
                },
                "thinking_mode": {
                  "bsonType": "string",
                  "description": "本次实际使用的思考模式",
                  "enum": [
                    "default",
                    "enabled",
                    "disabled"
                  ]
