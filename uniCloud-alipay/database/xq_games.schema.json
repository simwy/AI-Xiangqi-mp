                "started_at": {
                  "bsonType": "timestamp",
                  "description": "请求开始 UTC 毫秒"
                },
                "finished_at": {
                  "bsonType": "timestamp",
                  "description": "请求结束 UTC 毫秒；未完成则省略"
                },
                "duration_ms": {
                  "bsonType": "int",
                  "description": "服务端实测请求耗时；未完成则省略",
