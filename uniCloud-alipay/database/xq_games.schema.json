                },
                "status": {
                  "bsonType": "string",
                  "description": "请求状态",
                  "enum": [
                    "running",
                    "succeeded",
                    "failed",
                    "interrupted"
                  ]
                },
                "provider_request_id": {
                  "bsonType": "string",
                  "description": "供应商请求标识"
                },
                "usage": {
                  "bsonType": "object",
                  "description": "供应商实际返回的 Token 用量；未返回的字段省略"
                },
                "error": {
                  "bsonType": "object",
                  "description": "脱敏错误类别与简短说明"
                },
                "final_output": {
                  "bsonType": "string",
                  "description": "可选脱敏最终回答；不包含完整推理"
                }
              },
              "required": [
                "id",
                "purpose",
                "attempt",
                "model_id",
                "started_at",
                "status"
              ]
            }
          },
