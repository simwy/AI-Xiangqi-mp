{
  "bsonType": "object",
  "description": "大模型配置。后台维护；所有凭据仅服务端可读。",
  "required": [
    "display_name",
    "base_url",
    "model_name"
  ],
  "permission": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false,
    "count": false
  },
  "properties": {
    "_id": {
      "bsonType": "string",
      "description": "稳定文档 ID；由服务端生成或导入时重新分配"
    },
    "display_name": {
      "bsonType": "string",
      "description": "界面显示名称",
      "minLength": 1,
      "maxLength": 80
    },
    "avatar_url": {
      "bsonType": "string",
      "description": "形象图片 URL 或静态资源路径"
    },
    "provider": {
      "bsonType": "string",
      "description": "供应商标识，仅用于适配与管理"
    },
    "base_url": {
      "bsonType": "string",
      "description": "OpenAI 兼容接口基址；服务端校验 HTTPS 和目标地址",
      "minLength": 1
    },
    "model_name": {
      "bsonType": "string",
      "description": "API 请求使用的实际模型 ID",
      "minLength": 1,
      "maxLength": 200
    },
    "api_key": {
      "bsonType": "string",
      "description": "API 密钥或 enc:v1: 密文；禁止出现在公开接口",
      "permission": {
        "read": false,
        "write": false
      }
    },
    "api_key_env": {
      "bsonType": "string",
      "description": "可选服务端环境变量名称；优先于 api_key"
    },
    "enabled": {
      "bsonType": "bool",
      "description": "是否启用",
      "defaultValue": false
    },
    "can_play": {
      "bsonType": "bool",
      "description": "可作为棋手",
      "defaultValue": true
    },
    "can_commentate": {
      "bsonType": "bool",
      "description": "可作为解说文本模型",
      "defaultValue": false
    },
    "allow_vote": {
      "bsonType": "bool",
      "description": "可参与下局投票",
      "defaultValue": true
    },
    "sort_order": {
      "bsonType": "int",
      "description": "展示和同票排序",
      "defaultValue": 0
    },
    "thinking_mode": {
      "bsonType": "string",
      "description": "默认/开启/关闭思考",
      "enum": [
        "default",
        "enabled",
        "disabled"
      ],
      "defaultValue": "default"
    },
    "thinking_adapter": {
      "bsonType": "string",
      "description": "对应供应商的思考参数格式",
      "enum": [
        "none",
        "thinking_type",
        "enable_thinking",
        "reasoning_effort"
      ],
      "defaultValue": "none"
    },
    "reasoning_effort": {
      "bsonType": "string",
      "description": "供应商支持的思考强度；不支持时不设置"
    },
    "disabled_effort": {
      "bsonType": "string",
      "description": "reasoning_effort 适配器关闭思考所需值"
    },
    "temperature": {
      "bsonType": "double",
      "description": "可选温度；不支持的模型不传",
      "minimum": 0,
      "maximum": 2
    },
    "max_tokens": {
      "bsonType": "int",
      "description": "输出 Token 上限",
      "minimum": 1,
      "maximum": 262144,
      "defaultValue": 4096
    },
    "token_limit_field": {
      "bsonType": "string",
      "description": "Token 上限字段",
      "enum": [
        "max_tokens",
        "max_completion_tokens"
      ],
      "defaultValue": "max_tokens"
    },
    "timeout_ms": {
      "bsonType": "int",
      "description": "单次请求超时毫秒",
      "minimum": 1000,
      "maximum": 300000,
      "defaultValue": 45000
    },
    "max_attempts": {
      "bsonType": "int",
      "description": "总尝试次数，包含首次",
      "minimum": 1,
      "maximum": 5,
      "defaultValue": 3
    },
    "extra_body": {
      "bsonType": "object",
      "description": "额外供应商参数；服务端禁止覆盖模型、消息、思考开关和鉴权"
    },
    "revision": {
      "bsonType": "int",
      "description": "配置版本",
      "minimum": 1,
      "defaultValue": 1
    },
    "created_at": {
      "bsonType": "timestamp",
      "description": "创建时间 UTC 毫秒"
    },
    "updated_at": {
      "bsonType": "timestamp",
      "description": "修改时间 UTC 毫秒"
    }
  },
  "version": "1.0.0"
}
